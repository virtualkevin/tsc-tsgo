{
  "name": "tsc-ts",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build:go": "npm run build -w @tsc-ts/go",
    "test:go": "npm test -w @tsc-ts/go",
    "bench:projects": "node benchmarks/run.mjs",
    "build": "npm run build:go",
    "dev:web": "npm run dev -w @tsc-ts/web",
    "build:web": "npm run build -w @tsc-ts/web",
    "build:oracle": "turbo run build:oracle",
    "fetch:upstream": "node scripts/fetch-upstream.mjs",
    "test": "npm run test:go",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:reference": "npm run build -w tsc-ts",
    "build:reference:native": "npm run build:native -w tsc-ts",
    "test:reference": "turbo run test --filter=tsc-ts",
    "test:parity": "npm run test:parity -w @tsc-ts/go",
    "build:all": "turbo run build",
    "test:all": "turbo run test"
  },
  "devDependencies": {
    "@scriptc/threads": "0.3.5",
    "@types/node": "^24.19.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "scriptc": "0.3.5",
    "turbo": "2.11.7",
    "typescript": "5.9"
  },
  "packageManager": "npm@11.19.0"
}
