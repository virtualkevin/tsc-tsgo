{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 120,
  "ignorePatterns": [
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "packages/tsc-go/LICENSE",
    "packages/tsc-go/NOTICE.txt",
    "packages/tsc-go/internal/**",
    "packages/tsc-go/cmd/**",
    "benchmarks/results/**",
    "packages/tsc-ts/tests/fixtures/**",
    "**/dist/**",
    "**/.next/**",
    "**/.source/**",
    "**/next-env.d.ts",
    "upstream/**"
  ]
}
