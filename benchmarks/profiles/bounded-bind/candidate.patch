+// bindSourceFilesWithWorkers limits concurrent binder stacks and lets workers
+// claim another file as soon as their current file finishes.
+func (p *Program) bindSourceFilesWithWorkers() {
+	first := slices.IndexFunc(p.files, func(f *ast.SourceFile) bool { return !f.IsBound() })
+	if first < 0 {
+		return
+	}
+	files := p.files[first:]
+	var next atomic.Uint64
+	var wg sync.WaitGroup
+	for range min(len(files), runtime.GOMAXPROCS(0)) {
+		wg.Go(func() {
+			for {
+				i := next.Add(1) - 1
+				if i >= uint64(len(files)) {
+					return
+				}
+				file := files[i]
+				if !file.IsBound() {
+					p.bindSourceFileWithTracing(file)
+				}
+			}
+		})
+	}
+	wg.Wait()
+}
