+// reuseLoadedTask handles a repeated import whose only remaining effect is
+// linking this edge to the original task. Recursive discovery sometimes
+// revisits a path while holding its lock, so this path must never block.
+func (data *parseTaskData) reuseLoadedTask(task *parseTask, depth int) bool {
+	if !data.mu.TryLock() {
+		return false
+	}
+	defer data.mu.Unlock()
+	existing := data.tasks[task.normalizedFilePath]
+	if len(data.tasks) != 1 || existing == nil || !existing.loaded {
+		return false
+	}
+	if depth < data.lowestDepth || (data.packageId.Name == "" && task.packageId.Name != "") {
+		return false
+	}
+	task.loadedTask = existing
+	return true
 }
 
