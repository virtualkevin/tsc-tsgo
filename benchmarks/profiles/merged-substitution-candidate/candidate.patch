 func (m *MergedTypeMapper) Map(t *Type) *Type {
+	if m.substitution != nil {
+		if result, ok := m.substitution[t]; ok {
+			return result
+		}
+		return t
+	}
 	return m.m2.Map(m.m1.Map(t))
 }
 
