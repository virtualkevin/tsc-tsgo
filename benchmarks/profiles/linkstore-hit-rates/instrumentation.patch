@@ -0,0 +1,77 @@
+package core
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"reflect"
+	"strconv"
+	"sync"
+	"sync/atomic"
+)
+
+// Exploratory instrumentation only. Atomic counters perturb execution and
+// these builds must never be used for performance timings.
+var linkStoreProfileOnce sync.Once
+var linkStoreProfilePath = os.Getenv("TSC_GO_LINKSTORE_PROFILE")
+var linkStoreProfiles struct {
+	sync.Mutex
+	entries []*linkStoreProfile
+}
+
+type linkStoreProfile struct {
+	id                  int
+	keyType             string
+	valueType           string
+	getCalls            atomic.Uint64
+	lastInsertedMatches atomic.Uint64
+	mapHits             atomic.Uint64
+	newCalls            atomic.Uint64
+	insertions          atomic.Uint64
+}
+
+func newLinkStoreProfile[K comparable, V any]() *linkStoreProfile {
+	linkStoreProfiles.Lock()
+	defer linkStoreProfiles.Unlock()
+	p := &linkStoreProfile{id: len(linkStoreProfiles.entries), keyType: reflect.TypeFor[K]().String(), valueType: reflect.TypeFor[V]().String()}
+	linkStoreProfiles.entries = append(linkStoreProfiles.entries, p)
+	return p
+}
+
+// WriteLinkStoreProfile writes per-instance counters after command completion.
+// Existing populated-store reads change counters only through atomic methods.
+func WriteLinkStoreProfile() {
+	linkStoreProfileOnce.Do(writeLinkStoreProfile)
+}
+
+func writeLinkStoreProfile() {
+	if linkStoreProfilePath == "" {
+		return
+	}
+	type entry struct {
+		ID                  int    `json:"id"`
+		KeyType             string `json:"keyType"`
+		ValueType           string `json:"valueType"`
+		GetCalls            uint64 `json:"getCalls"`
+		LastInsertedMatches uint64 `json:"lastInsertedMatches"`
+		MapHits             uint64 `json:"mapHits"`
+		NewCalls            uint64 `json:"newCalls"`
+		Insertions          uint64 `json:"insertions"`
+	}
+	linkStoreProfiles.Lock()
+	entries := make([]entry, 0, len(linkStoreProfiles.entries))
+	for _, p := range linkStoreProfiles.entries {
+		entries = append(entries, entry{p.id, p.keyType, p.valueType, p.getCalls.Load(), p.lastInsertedMatches.Load(), p.mapHits.Load(), p.newCalls.Load(), p.insertions.Load()})
+	}
+	linkStoreProfiles.Unlock()
+	data, err := json.MarshalIndent(struct {
+		Purpose string  `json:"purpose"`
+		Stores  []entry `json:"stores"`
+	}{"Exploratory last-inserted cache hit-rate instrumentation; not a benchmark", entries}, "", "  ")
+	if err == nil {
+		err = os.WriteFile(linkStoreProfilePath+"."+strconv.Itoa(os.Getpid())+".json", append(data, '\n'), 0644)
+	}
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "LinkStore profile: %v\n", err)
+	}
+}
