+func TestSemanticCensusFamilyAggregation(t *testing.T) {
+	path := censusTestEnvironment(t)
+	t.Setenv("TSC_GO_CENSUS_MODE", "families")
+	c := &Checker{census: newSemanticCensus(1)}
+	s := c.census
+	outer := c.beginCensus(censusKey{family: censusFamilies[0], mode: 1})
+	inner := c.beginCensus(censusKey{family: censusFamilies[0], mode: 2})
+	if outer == inner || outer.record != inner.record {
+		t.Fatal("family recursion requires separate spans and shared aggregate")
+	}
+	c.TypeCount += 2
+	inner.returnedNormally = true
+	inner.finish(c)
+	outer.returnedNormally = true
+	outer.finish(c)
+	r := s.ordered[0]
+	if r.TypesCreated != 4 || r.NestedSameRawKeyEntries != 0 || r.Calls != 2 || r.Active != 0 {
+		t.Fatal("incorrect identity or inclusive accounting")
+	}
+	for i := 0; i < censusRecordLimit+1; i++ {
+		span := c.beginCensus(censusKey{family: censusFamilies[i%4], mode: uint32(i)})
+		if span != outer || span.returnedNormally || span.children != 0 {
+			t.Fatal("span reuse failed")
+		}
+		span.returnedNormally = true
+		span.finish(c)
+	}
+	if s.records != nil || len(s.ordered) != 4 || len(s.spanPool) != 2 || s.overflow.Calls != 0 {
+		t.Fatal("retained pointer keys or overflowed")
+	}
+	var calls uint64
+	for _, r := range s.ordered {
+		calls += r.Calls
+		if r.NodeAddress != "" || r.SymbolAddress != "" || r.TypeAddress != "" || r.MapperAddress != "" || r.AliasAddress != "" || r.NestedSameRawKeyEntries != 0 || r.ExclusiveNanoseconds < 0 {
+			t.Fatal("unexpected detail or invalid accounting")
+		}
+	}
+	if calls != censusRecordLimit+3 {
+		t.Fatal("lost calls", calls)
+	}
+	if err := FlushSemanticCensus(); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(data, []byte(`"familyOnly":true`)) {
+		t.Fatal("mode missing from output")
+	}
+}
