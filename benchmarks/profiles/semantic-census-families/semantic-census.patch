+func TestSemanticCensusFamilyRuntimeLabels(t *testing.T) {
+	censusTestEnvironment(t)
+	t.Setenv("TSC_GO_CENSUS_MODE", "families")
+	t.Setenv("TSC_GO_CENSUS_CPU_LABELS", "1")
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		pprof.SetGoroutineLabels(context.Background())
+		defer pprof.SetGoroutineLabels(context.Background())
+		c := &Checker{census: newSemanticCensus(17)}
+		for repeat := 0; repeat < 2; repeat++ {
+			outer := c.beginCensus(censusKey{family: censusFamilies[0]})
+			inner := c.beginCensus(censusKey{family: censusFamilies[1]})
+			if got := semanticCensusRuntimeLabels(t); got["census_record"] != "1" || got["census_family"] != censusFamilies[1] || got["census_checker"] != "17" {
+				t.Fatal("inner labels", got)
+			}
+			inner.finish(c)
+			if got := semanticCensusRuntimeLabels(t); got["census_record"] != "0" || got["census_family"] != censusFamilies[0] {
+				t.Fatal("parent labels", got)
+			}
+			outer.finish(c)
+			if got := semanticCensusRuntimeLabels(t); len(got) != 0 {
+				t.Fatal("labels leaked", got)
+			}
+		}
+	}()
+	<-done
+}
