+// The caller has captured a unique-name property list in its original order.
+// Keep skipped-side lookup before either property type is resolved, and avoid
+// resolving either type when the two contributions are the same symbol.
+func (c *Checker) hasNeverReducedSmallPair(t *Type, skipped *Type, properties []*ast.Symbol, names []string) bool {
+	skippedType := c.getApparentType(skipped)
+	if c.isErrorType(skippedType) || skippedType.flags&TypeFlagsNever != 0 {
+		return false
+	}
+	for i, prop := range properties {
+		other := c.getPropertyOfTypeEx(skippedType, names[i], true, false)
+		if other == nil || other == prop {
+			continue
+		}
+		pair := [2]*ast.Symbol{prop, other}
+		if !c.someLiteralOrPrivateProperty(pair[:]) {
+			continue
+		}
+		combined := c.getPropertyOfUnionOrIntersectionType(t, names[i], true)
+		if combined != nil && c.isNeverReducedProperty(combined) {
+			return true
+		}
+	}
+	return false
+}
