+// IdentifierNames returns the original parser's collision-name set. The loader
+// is shared by source-file clones and runs at most once, including concurrent readers.
+// The returned map must be treated as read-only.
+func (node *SourceFile) IdentifierNames() map[string]string {
+	if node.identifierNames == nil {
+		return nil
+	}
+	return node.identifierNames()
+}
+
+// SetIdentifierNames installs a loader before the source file is published.
+func (node *SourceFile) SetIdentifierNames(load func() map[string]string) {
+	node.identifierNames = sync.OnceValue(load)
+}
+
 func (node *SourceFile) BindDiagnostics() []*Diagnostic {
 	return node.bindDiagnostics
 }
