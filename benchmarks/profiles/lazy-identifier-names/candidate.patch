--- a/packages/tsc-go/internal/parser/parser.go
+++ b/packages/tsc-go/internal/parser/parser.go
@@ -85,6 +85,7 @@ type Parser struct {
 	hasParseError               bool
 
 	identifiers                map[string]string
+	collectIdentifiers         bool
 	identifierCount            int
 	notParenthesizedArrow      collections.Set[int]
 	nodeSliceArena             core.Arena[*ast.Node]
@@ -135,9 +136,14 @@ func putParser(p *Parser) {
 }
 
 func ParseSourceFile(opts ast.SourceFileParseOptions, sourceText string, scriptKind core.ScriptKind) *ast.SourceFile {
+	return parseSourceFileWithIdentifierNames(opts, sourceText, scriptKind, false)
+}
+
+func parseSourceFileWithIdentifierNames(opts ast.SourceFileParseOptions, sourceText string, scriptKind core.ScriptKind, collect bool) *ast.SourceFile {
 	p := getParser()
 	defer putParser(p)
 	p.initializeState(opts, sourceText, scriptKind)
+	p.collectIdentifiers = collect
 	p.nextToken()
 	if p.scriptKind == core.ScriptKindJSON {
 		return p.parseJSONText()
@@ -473,7 +479,18 @@ func (p *Parser) finishSourceFile(result *ast.SourceFile, isDeclarationFile bool
 	result.LanguageVariant = p.languageVariant
 	result.ScriptKind = p.scriptKind
 	result.Flags |= p.sourceFlags
-	result.Identifiers = p.identifiers
+	if p.collectIdentifiers {
+		names := p.identifiers
+		result.SetIdentifierNames(func() map[string]string { return names })
+	} else {
+		// Capture immutable inputs, never the pooled parser or the parsed AST. A
+		// replay preserves names from speculation, error recovery, JSDoc and reparse
+		// paths that a walk of the final AST would miss.
+		opts, text, kind := p.opts, p.sourceText, p.scriptKind
+		result.SetIdentifierNames(func() map[string]string {
+			return parseSourceFileWithIdentifierNames(opts, text, kind, true).IdentifierNames()
+		})
+	}
 	result.NodeCount = p.factory.NodeCount()
 	result.TextCount = p.factory.TextCount()
 	result.IdentifierCount = p.identifierCount
@@ -5904,6 +5921,9 @@ func (p *Parser) createIdentifierWithDiagnostic(isIdentifier bool, diagnosticMes
 }
 
 func (p *Parser) internIdentifier(text string) string {
+	if !p.collectIdentifiers {
+		return text
+	}
 	if identifier, ok := p.identifiers[text]; ok {
 		return identifier
 	}
