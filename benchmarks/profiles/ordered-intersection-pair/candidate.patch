+// A strictly ordered property list has unique names. Keep the snapshot in
+// enumeration order so recursive lookup observes the ordinary resolution order.
+func (c *Checker) reduceOrderedPair(t, skipped *Type, properties []*ast.Symbol) (result, handled bool) {
+	for i := 1; i < len(properties); i++ {
+		if properties[i-1].Name >= properties[i].Name {
+			return false, false
+		}
+	}
+	type entry struct {
+		name   string
+		symbol *ast.Symbol
+	}
+	entries := make([]entry, len(properties))
+	for i, prop := range properties {
+		entries[i] = entry{prop.Name, prop}
+	}
+	apparent := c.getApparentType(skipped)
+	if c.isErrorType(apparent) || apparent.flags&TypeFlagsNever != 0 {
+		return false, true
+	}
+	for _, e := range entries {
+		other := c.getPropertyOfTypeEx(apparent, e.name, true, false)
+		if other == nil || other == e.symbol || !c.someLiteralOrPrivateProperty([]*ast.Symbol{e.symbol, other}) {
+			continue
+		}
+		combined := c.getPropertyOfUnionOrIntersectionType(t, e.name, true)
+		if combined != nil && c.isNeverReducedProperty(combined) {
+			return true, true
+		}
+	}
+	return false, true
