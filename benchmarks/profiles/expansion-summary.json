  "recommendations": [
    {
      "priority": 1,
      "experiment": "PGO with the merged CPU profile",
      "reason": "Low semantic risk, measures compiler optimization opportunities across all four observed paths; preserve non-PGO control and validate output before fresh timings.",
      "limitation": "Unweighted merge heavily favors VSCode and Sentry because their profiles have far more CPU samples."
    },
    {
      "priority": 2,
      "experiment": "Reduce LinkStore pointer-map lookups with checker-local ownership-safe storage",
      "reason": "Inclusive LinkStore CPU is 15.04% in VSCode and 12.62% in Sentry, dominated by map probes. Transient-symbol direct/owned storage or validated locality caches warrant a separate identity/concurrency audit."
    },
    {
      "priority": 3,
      "experiment": "Per-checker typed arenas for concrete Type shapes",
      "reason": "Individual concrete constructors allocate~1.13M objects/~200MiB in VSCode and~1.04M/~198MiB in Sentry. This preserves Go typed pointers and avoids unsafe TypeData representation changes.",
      "limitation": "Direct inclusive constructor CPU is only 1.73%/0.91%; gains would mainly be GC/object-count reduction. Arena tail waste, sibling retention and API-held checker lifetime must be measured. Initialize fields exactly as today; no reuse or pooling across checkers."
    },
    {
