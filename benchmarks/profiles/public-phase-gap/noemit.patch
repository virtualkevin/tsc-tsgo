+// NoEmitResultAfterDiagnostics reports which outputs the plain CLI would skip.
+// A cold or nonempty declaration diagnostic entry requires the ordinary emitter.
+func (p *Program) NoEmitResultAfterDiagnostics() *EmitResult {
+	options := p.Options()
+	if !options.NoEmit.IsTrue() || options.NoEmitOnError.IsTrue() || p.opts.Tracing != nil {
+		return nil
+	}
+	result := &EmitResult{}
+	for _, file := range p.getSourceFilesToEmit(nil, false) {
+		paths := outputpaths.GetOutputPathsFor(file, options, p, false)
+		if paths.DeclarationFilePath() != "" {
+			diags, checked := p.declarationDiagnosticCache.Load(file)
+			if !checked || len(diags) != 0 {
+				return nil
+			}
+			result.EmitSkipped = true
+		} else if paths.JsFilePath() != "" {
+			result.EmitSkipped = true
+			if !options.GetEmitDeclarations() {
+				return result
+			}
+		}
+	}
+	return result
+}
