+package compiler_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/microsoft/typescript-go/internal/compiler"
+	"github.com/microsoft/typescript-go/internal/core"
+	"github.com/microsoft/typescript-go/internal/tsoptions"
+	"github.com/microsoft/typescript-go/internal/vfs/vfstest"
+)
+
+func TestNoEmitResultAfterDiagnostics(t *testing.T) {
+	for _, test := range []struct {
+		name, file, source string
+		declarations       bool
+		wantDiagnostic     bool
+		wantSkipped        bool
+	}{
+		{"javascript output", "one.ts", "export const n = 1", false, false, true},
+		{"checked declarations", "one.ts", "export const n: number = 1", true, false, true},
+		{"declaration error", "one.ts", "export function f(x: number) { return x + 1 }", true, true, true},
+		{"no output for declaration input", "one.d.ts", "export declare const n: number", true, false, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			name := "/src/" + test.file
+			fs := vfstest.FromMap(map[string]string{name: test.source}, true)
+			opts := &core.CompilerOptions{NoEmit: core.TSTrue, NoLib: core.TSTrue, Target: core.ScriptTargetES2015}
+			if test.declarations {
+				opts.Declaration = core.TSTrue
+				opts.IsolatedDeclarations = core.TSTrue
+			}
+			host := compiler.NewCompilerHost("/src", fs, "/lib", nil, nil)
+			config := &tsoptions.ParsedCommandLine{ParsedConfig: &core.ParsedOptions{FileNames: []string{name}, CompilerOptions: opts}}
+			p := compiler.NewProgram(compiler.ProgramOptions{Config: config, Host: host})
+			if test.declarations && test.wantSkipped && p.NoEmitResultAfterDiagnostics() != nil {
+				t.Fatal("cold declaration diagnostics must go through emit")
+			}
+			diags := p.GetDeclarationDiagnostics(t.Context(), nil)
+			if (len(diags) > 0) != test.wantDiagnostic {
+				t.Fatalf("unexpected declaration diagnostics: %v", diags)
+			}
+			skipped := p.NoEmitResultAfterDiagnostics()
+			if test.wantDiagnostic {
+				if skipped != nil {
+					t.Fatal("lost declaration diagnostics")
+				}
+				return
+			}
+			ordinary := p.Emit(t.Context(), compiler.EmitOptions{})
+			if skipped == nil || skipped.EmitSkipped != test.wantSkipped || !reflect.DeepEqual(skipped, ordinary) {
+				t.Fatalf("fast result %#v, ordinary result %#v", skipped, ordinary)
+			}
+		})
+	}
+}
