+package checker_test
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestStringTemplateEntryGuardRepeatedDiagnostics(t *testing.T) {
+	const source = "declare const bad: 'wrong';\n" +
+		"declare let target: `pre-${string}-post`;\n" +
+		"target = bad;\ntarget = bad;\n" +
+		"const good: `pre-${string}-post` = 'pre-x-post';\n" +
+		"type InferMiddle<T extends string> = T extends `pre-${infer U}-post` ? U : never;\n" +
+		"const inferred: InferMiddle<'pre-x-post'> = 'x';\n" +
+		"function deferred<T extends string>(value: `pre-${T}-post`) { return value; }\n" +
+		"const result: 'pre-x-post' = deferred('pre-x-post');\n"
+	c, file := pendingAPIChecker(t, source)
+	bad := pendingVariableType(c, file, 0)
+	target := pendingVariableType(c, file, 1)
+	for range 2 {
+		if c.IsTypeAssignableTo(bad, target) {
+			t.Fatal("rejected literal became assignable")
+		}
+	}
+	first, second := strings.Index(source, "target = bad"), strings.LastIndex(source, "target = bad")
+	for attempt := 0; attempt < 2; attempt++ {
+		ds := c.GetDiagnostics(t.Context(), file)
+		if len(ds) != 2 {
+			t.Fatalf("query %d: want two assignment errors and valid inference, got %v", attempt, ds)
+		}
+		positions := map[int]bool{}
+		for _, d := range ds {
+			if d.Code() != 2322 || d.File() != file {
+				t.Fatalf("query %d: unexpected diagnostic %v", attempt, d)
+			}
+			positions[d.Pos()] = true
+		}
+		if !positions[first] || !positions[second] {
+			t.Fatalf("query %d: positions %v, want %d and %d", attempt, positions, first, second)
+		}
+	}
+}
