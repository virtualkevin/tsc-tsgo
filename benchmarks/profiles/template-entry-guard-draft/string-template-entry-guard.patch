+package checker
+
+import (
+	"fmt"
+	"testing"
+)
+
+func templateEntryGuardChecker() *Checker {
+	c := templateCacheTestChecker()
+	c.strictNullChecks = true
+	c.assignableRelation = &Relation{}
+	c.comparableRelation = &Relation{}
+	c.subtypeRelation = &Relation{}
+	c.strictSubtypeRelation = &Relation{}
+	c.identityRelation = &Relation{}
+	return c
+}
+
+// The full relater does not call the new entry guard for the top-level pair.
+// Explicit semantic expectations prevent both paths agreeing on a shared bug.
+func TestStringTemplateEntryGuardMatchesFullRelater(t *testing.T) {
+	cases := []struct {
+		name, text, start, end string
+		matches               bool
+	}{
+		{"prefix mismatch", "wrong-post", "pre-", "-post", false},
+		{"suffix mismatch", "pre-wrong", "pre-", "-post", false},
+		{"overlapping prefix suffix", "aaa", "aa", "aa", false},
+		{"empty source", "", "a", "", false},
+		{"nonempty suffix", "", "", "z", false},
+		{"unicode mismatch", "猫x犬", "犬", "犬", false},
+		{"nul mismatch", "a\x00x", "a\x00", "z", false},
+		{"ordinary match", "pre-x-post", "pre-", "-post", true},
+		{"empty interpolation", "pre--post", "pre-", "-post", true},
+		{"empty all", "", "", "", true},
+		{"unicode match", "猫😀犬", "猫", "犬", true},
+		{"nul match", "a\x00xz", "a\x00", "z", true},
+	}
+	for _, test := range cases {
+		for relationIndex := 0; relationIndex < 5; relationIndex++ {
+			for _, fresh := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%s/relation%d/fresh%t", test.name, relationIndex, fresh), func(t *testing.T) {
+					c := templateEntryGuardChecker()
+					relations := []*Relation{c.assignableRelation, c.comparableRelation, c.subtypeRelation, c.strictSubtypeRelation, c.identityRelation}
+					relation := relations[relationIndex]
+					source := c.getStringLiteralType(test.text)
+					if fresh {
+						source = c.getFreshTypeOfLiteralType(source)
+					}
+					target := c.newTemplateLiteralType([]string{test.start, test.end}, []*Type{c.stringType})
+					c.reliabilityFlags = RelationComparisonResultReportsUnmeasurable
+					got := c.isTypeRelatedTo(source, target, relation)
+					flags := c.reliabilityFlags
+					if !test.matches && (c.freeRelater != nil || relation.size() != 0) {
+						t.Fatal("finite text rejection entered the relater or populated its cache")
+					}
+					// Do not let a previous fast/full result supply the oracle's answer.
+					relation.results = nil
+					c.reliabilityFlags = RelationComparisonResultReportsUnmeasurable
+					full := c.checkTypeRelatedTo(source, target, relation, nil)
+					want := test.matches && relation != c.identityRelation
+					if got != want || full != want || flags != c.reliabilityFlags {
+						t.Fatalf("entry=%v full=%v want=%v, flags=%v fullFlags=%v", got, full, want, flags, c.reliabilityFlags)
+					}
+				})
+			}
+		}
+	}
+}
+
+// Template sources are deliberately outside the guard. Even an obvious text
+// mismatch must retain variance reporting when a placeholder is a marker type.
+func TestStringTemplateEntryGuardPreservesTemplateVarianceReporting(t *testing.T) {
+	c := templateEntryGuardChecker()
+	c.markerSuperType = c.newTypeParameter(nil)
+	c.reportUnreliableMapper = newFunctionTypeMapper(c.reportUnreliableWorker)
+	source := c.newTemplateLiteralType([]string{"left-", ""}, []*Type{c.markerSuperType})
+	target := c.newTemplateLiteralType([]string{"right-", ""}, []*Type{c.stringType})
+	if c.isTypeRelatedTo(source, target, c.assignableRelation) {
+		t.Fatal("incompatible template texts related")
+	}
+	if c.reliabilityFlags&RelationComparisonResultReportsUnreliable == 0 {
+		t.Fatal("template placeholder variance effect was skipped")
+	}
+}
