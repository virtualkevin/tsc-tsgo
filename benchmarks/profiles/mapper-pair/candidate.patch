+
+// The new simple mapper is owned by the new merged mapper. Allocate them
+// together while preserving their concrete types and traversal order, which
+// are also used by mapper comparison and declaration serialization.
+// An independently retained child can keep the whole pair alive.
+func newPairedTypeMapping(source, target *Type, mapper *TypeMapper, prepend bool) *TypeMapper {
+	pair := &struct {
+		merged MergedTypeMapper
+		simple SimpleTypeMapper
+	}{}
+	pair.simple.data = &pair.simple
+	pair.simple.source = source
+	pair.simple.target = target
+	pair.merged.data = &pair.merged
+	if prepend {
+		pair.merged.m1 = &pair.simple.TypeMapper
+		pair.merged.m2 = mapper
+	} else {
+		pair.merged.m1 = mapper
+		pair.merged.m2 = &pair.simple.TypeMapper
+	}
+	return &pair.merged.TypeMapper
 }
 
