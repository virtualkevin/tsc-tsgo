 func (b *keyBuilder) writeUint32(value uint32) {
-	var bytes [4]byte
-	binary.LittleEndian.PutUint32(bytes[:], value)
-	b.writeBytes(bytes[:])
+	if b.overflow == nil && b.n <= len(b.buf)-4 {
+		binary.LittleEndian.PutUint32(b.buf[b.n:], value)
+		b.n += 4
